{
  "expo": {
    "name": "边小二",
    "slug": "bian-xiao-er",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bianxiaoer",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F0FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.manus.bianxiaoer.app.t20260605",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "边小二需要使用您的位置来查找附近的商户和导航",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "边小二需要使用您的位置来查找附近的商户和导航"
      }
    },
    "android": {
      "package": "com.bianxiaoer.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#E8F0FE"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font"
    ],
    "primaryColor": "#2E6BE6"
  }
}
